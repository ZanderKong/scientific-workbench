{
  "name": "scientific-workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @workbench/server dev\" \"pnpm --filter @workbench/web dev\"",
    "build": "tsx scripts/build-agent-knowledge.ts && pnpm -r build",
    "start": "pnpm --filter @workbench/server start",
    "test": "tsx scripts/build-agent-knowledge.ts && pnpm -r test",
    "agent:knowledge": "tsx scripts/build-agent-knowledge.ts",
    "agent:knowledge:check": "tsx scripts/build-agent-knowledge.ts --check",
    "test:e2e": "playwright test",
    "demo": "tsx scripts/create-demo.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "typecheck": "tsx scripts/build-agent-knowledge.ts && pnpm -r typecheck",
    "api:spec": "tsx scripts/generate-api-spec.ts",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.5",
    "@types/pngjs": "6.0.5",
    "concurrently": "^9.1.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
