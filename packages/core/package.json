{
  "name": "@workbench/core",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./attachments": {
      "types": "./dist/attachments.d.ts",
      "import": "./src/attachments.ts",
      "default": "./src/attachments.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
