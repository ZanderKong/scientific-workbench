{
  "name": "@workbench/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx ../../scripts/build-agent-knowledge.ts && tsx watch src/main.ts",
    "start": "tsx ../../scripts/build-agent-knowledge.ts && tsx src/main.ts",
    "build": "tsx ../../scripts/build-agent-knowledge.ts && tsc -p tsconfig.json",
    "typecheck": "tsx ../../scripts/build-agent-knowledge.ts && tsc -p tsconfig.json --noEmit",
    "test": "tsx ../../scripts/build-agent-knowledge.ts && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/lib-storage": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@opencode/client": "2.0.7",
    "@workbench/core": "workspace:*",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.3",
    "unzipper": "^0.12.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
